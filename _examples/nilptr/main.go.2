// This example demonstrates a common issue in Go when dealing with nil pointers. The `bindConfig` function attempts to unmarshal JSON into a `Config` struct, but if the unmarshalling fails (for example, due to an invalid type), it returns nil. The `prepareConfig` function then passes this nil pointer to `startServer`, which dereferences it without checking for nil, leading to a runtime panic.
package main

import (
	"encoding/json"
	"fmt"
	"log"
)

type Config struct {
	Host string `json:"host"`
	Port int    `json:"port"`
}

type Request struct {
	Body []byte
}

// Simulates binding an incoming HTTP request body.
func bindConfig(req *Request) *Config {
	var cfg Config

	if err := json.Unmarshal(req.Body, &cfg); err != nil {
		log.Println("failed to bind config:", err)
		return nil
	}

	return &cfg
}

// Simulates a validation or processing layer.
func prepareConfig(req *Request) *Config {
	cfg := bindConfig(req)

	// Additional processing happens here.
	return cfg
}

// A separate service consumes the configuration.
func startServer(cfg *Config) {
	address := fmt.Sprintf("%s:%d", cfg.Host, cfg.Port)
	fmt.Println("Starting server at", address)
}

func main() {
	req := &Request{
		Body: []byte(`{"host": "localhost", "port": "invalid"}`),
	}

	cfg := prepareConfig(req)

	startServer(cfg)
}
